# AI PROVIDERS - OpenRouter (https://openrouter.ai/keys)
# OpenRouter mendukung 200+ model dari OpenAI, Anthropic, Google, dll
# =============================================================================
OPENROUTER_API_KEY="sk-or-v1-..."

# Model untuk code generation agent (default: openai/gpt-4.1)
# Contoh lain: anthropic/claude-sonnet-4-5, google/gemini-2.5-flash, openai/gpt-4o
OPENROUTER_MODEL="openai/gpt-4.1"

# Model untuk vision/design extraction (harus support image input)
# Contoh lain: anthropic/claude-sonnet-4-5, openai/gpt-4o
